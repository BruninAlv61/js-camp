---
const reviews = [
  {
    id: 1,
    name: 'Roberto Sánchez',
    business: 'Tienda de Electrónica',
    avatar: '👨‍💼',
    rating: 5,
    text: 'Desde que usamos dalePOS, nuestras ventas han aumentado un 30%. La interfaz es intuitiva y el soporte es excelente.',
    location: 'Ciudad de México'
  },
  {
    id: 2,
    name: 'Carmen Torres',
    business: 'Restaurante El Sabor',
    avatar: '👩‍🍳',
    rating: 5,
    text: 'El sistema de inventario nos ha ahorrado horas de trabajo. Ahora podemos enfocarnos en lo importante: atender a nuestros clientes.',
    location: 'Guadalajara'
  },
  {
    id: 3,
    name: 'Miguel Ángel',
    business: 'Supermercado Express',
    avatar: '👨‍💻',
    rating: 4,
    text: 'Excelente relación calidad-precio. Мы recommendamos dalePOS a cualquier negocio que busque profesionalizar su gestión.',
    location: 'Monterrey'
  },
  {
    id: 4,
    name: 'Patricia Mendoza',
    business: 'Boutique Moda',
    avatar: '👩‍💼',
    rating: 5,
    text: 'La versión móvil es perfecta para nuestra tienda. Puedo gestionar mi negocio desde cualquier lugar.',
    location: 'Puebla'
  },
  {
    id: 5,
    name: 'Fernando López',
    business: 'Ferretería工业',
    avatar: '👨‍🔧',
    rating: 5,
    text: 'Teníamos un sistema obsoleto. La migración fue muy sencilla y el equipo de soporte nos acompañó en todo momento.',
    location: 'Tijuana'
  },
  {
    id: 6,
    name: 'Laura Gutiérrez',
    business: 'Café Latte',
    avatar: '👩‍🎨',
    rating: 5,
    text: 'Nos encanta el sistema de reportes. Podemos ver en tiempo real cómo va nuestro negocio y tomar mejores decisiones.',
    location: 'Cancún'
  }
];
---

<section class="reviews" id="reseñas">
  <div class="container">
    <div class="reviews-header">
      <span class="section-tag">Reseñas</span>
      <h2>Lo que dicen nuestros clientes</h2>
      <p>Miles de negocios ya confían en dalePOS para gestionar sus operaciones.</p>
    </div>

    <div class="reviews-grid">
      {reviews.map((review, index) => (
        <article class="review-card" style={`animation-delay: ${index * 0.1}s`}>
          <div class="review-header">
            <span class="review-avatar">{review.avatar}</span>
            <div class="review-info">
              <h4>{review.name}</h4>
              <span class="review-business">{review.business}</span>
            </div>
          </div>
          <div class="review-rating">
            {[...Array(5)].map((_, i) => (
              <svg 
                xmlns="http://www.w3.org/2000/svg" 
                fill={i < review.rating ? "currentColor" : "none"} 
                viewBox="0 0 24 24" 
                stroke="currentColor" 
                stroke-width="2"
                class={i < review.rating ? 'filled' : ''}
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            ))}
          </div>
          <blockquote class="review-text">"{review.text}"</blockquote>
          <div class="review-location">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {review.location}
          </div>
        </article>
      ))}
    </div>

    <div class="reviews-cta">
      <p>¿Ya usas dalePOS? Comparte tu experiencia</p>
      <a href="#contacto" class="review-button">Escribir Reseña</a>
    </div>
  </div>
</section>

<style>
  .reviews {
    padding: 80px 0;
  }

  .reviews-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 60px;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .reviews-header h2 {
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }

  .reviews-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 48px;
  }

  .review-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 28px;
    animation: fadeInUp 0.6s ease forwards;
    opacity: 0;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 229, 160, 0.1);
  }

  .review-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .review-avatar {
    font-size: 2.5rem;
  }

  .review-info h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .review-business {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .review-rating {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
  }

  .review-rating svg {
    width: 18px;
    height: 18px;
    color: var(--color-text-muted);
  }

  .review-rating svg.filled {
    color: #fbbf24;
  }

  .review-text {
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.7;
    font-style: italic;
    margin-bottom: 16px;
  }

  .review-location {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .review-location svg {
    width: 16px;
    height: 16px;
  }

  .reviews-cta {
    text-align: center;
    padding: 32px;
    background: var(--color-surface);
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .reviews-cta p {
    color: var(--color-text-muted);
    margin-bottom: 20px;
  }

  .review-button {
    display: inline-block;
    padding: 14px 28px;
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.2s;
  }

  .review-button:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
