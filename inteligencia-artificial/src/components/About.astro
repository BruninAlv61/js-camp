---
const features = [
  {
    icon: '🚀',
    title: 'Misión',
    description: ' Democratizar el acceso a herramientas profesionales de gestión comercial para negocios de todos los tamaños.'
  },
  {
    icon: '👁️',
    title: 'Visión',
    description: 'Ser la plataforma de referencia en América Latina para la transformación digital del comercio minorista.'
  },
  {
    icon: '💎',
    title: 'Valores',
    description: 'Innovación constante, transparencia, compromiso con el cliente y simplicidad en cada solución.'
  }
];

const team = [
  { name: 'Carlos Mendoza', role: 'CEO & Fundador', emoji: '👨‍💼' },
  { name: 'Ana García', role: 'CTO', emoji: '👩‍💻' },
  { name: 'Luis Rodríguez', role: 'Director de Producto', emoji: '👨‍🎨' },
  { name: 'María López', role: 'Head of Customer Success', emoji: '👩‍💼' }
];
---

<section class="about" id="nosotros">
  <div class="container">
    <div class="about-header">
      <span class="section-tag">Sobre Nosotros</span>
      <h2>Construyendo el futuro del comercio</h2>
      <p>Somos un equipo apasionado por la tecnología y el entrepreneurship, dedicados a crear soluciones que simplifican la gestión de negocios.</p>
    </div>

    <div class="features-grid">
      {features.map(feature => (
        <div class="feature-card">
          <span class="feature-icon">{feature.icon}</span>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      ))}
    </div>

    <div class="team-section">
      <h3>Nuestro Equipo</h3>
      <p class="team-intro">Conoce a las personas detrás de dalePOS</p>
      <div class="team-grid">
        {team.map(member => (
          <div class="team-member">
            <span class="member-avatar">{member.emoji}</span>
            <h4>{member.name}</h4>
            <span class="member-role">{member.role}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="about-cta">
      <h3>¿Listo para transformar tu negocio?</h3>
      <a href="#planes" class="cta-button">Empezar Ahora</a>
    </div>
  </div>
</section>

<style>
  .about {
    padding: 80px 0;
  }

  .about-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .about-header h2 {
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }

  .about-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 80px;
  }

  .feature-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 32px 24px;
    text-align: center;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 229, 160, 0.1);
  }

  .feature-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 16px;
  }

  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .feature-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .team-section {
    text-align: center;
    margin-bottom: 60px;
  }

  .team-section h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .team-intro {
    color: var(--color-text-muted);
    margin-bottom: 40px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    max-width: 600px;
    margin: 0 auto;
  }

  .team-member {
    background: var(--color-surface-elevated);
    border-radius: var(--radius);
    padding: 24px 16px;
    transition: transform 0.2s;
  }

  .team-member:hover {
    transform: scale(1.02);
  }

  .member-avatar {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 12px;
  }

  .team-member h4 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .member-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .about-cta {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 48px 24px;
    text-align: center;
  }

  .about-cta h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 24px;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 32px;
    background: var(--color-primary);
    color: var(--color-bg);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.2s;
  }

  .cta-button:hover {
    background: var(--color-primary-dim);
    transform: scale(1.02);
  }

  @media (min-width: 768px) {
    .about {
      padding: 120px 0;
    }

    .features-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    .team-grid {
      grid-template-columns: repeat(4, 1fr);
      max-width: 900px;
    }
  }
</style>
