---
const plans = [
  {
    name: 'Básico',
    price: '299',
    period: '/mes',
    description: 'Ideal para negocios pequeños que inician en el mundo digital.',
    featured: false,
    features: [
      { text: '1 usuario', included: true },
      { text: '100 productos', included: true },
      { text: 'Registro de ventas', included: true },
      { text: 'Reportes básicos', included: true },
      { text: 'Inventario avanzado', included: false },
      { text: 'Múltiples sucursales', included: false },
    ],
    buttonText: 'Empezar Gratis',
    buttonType: 'secondary'
  },
  {
    name: 'Pro',
    price: '599',
    period: '/mes',
    description: 'Para negocios en crecimiento que necesitan más potencia.',
    featured: true,
    features: [
      { text: '5 usuarios', included: true },
      { text: 'Productos ilimitados', included: true },
      { text: 'Inventario avanzado', included: true },
      { text: 'Reportes avanzados', included: true },
      { text: 'Integraciones API', included: true },
      { text: 'Múltiples sucursales', included: false },
    ],
    buttonText: 'Empezar Ahora',
    buttonType: 'primary'
  },
  {
    name: 'Empresarial',
    price: '1,299',
    period: '/mes',
    description: 'Solución completa para cadenas y franchises.',
    featured: false,
    features: [
      { text: 'Usuarios ilimitados', included: true },
      { text: 'Productos ilimitados', included: true },
      { text: 'Múltiples sucursales', included: true },
      { text: 'Inventario centralizado', included: true },
      { text: 'Dashboard ejecutivo', included: true },
      { text: 'Soporte prioritario 24/7', included: true },
    ],
    buttonText: 'Contact Sales',
    buttonType: 'secondary'
  }
];
---

<section class="pricing" id="planes">
  <div class="container">
    <div class="pricing-header">
      <span class="section-tag">Planes</span>
      <h2>Elige el plan perfecto para ti</h2>
      <p>Soluciones de punto de venta adaptadas a tu negocio. Sin contratos, sin sorpresas.</p>
    </div>

    <div class="pricing-grid">
      {plans.map((plan, index) => (
        <article class={`plan-card ${plan.featured ? 'featured' : ''}`}>
          {plan.featured && <span class="badge">Popular</span>}
          <h3 class="plan-name">{plan.name}</h3>
          <div class="plan-price">
            <span class="currency">$</span>{plan.price}<span class="period">{plan.period}</span>
          </div>
          <p class="plan-description">{plan.description}</p>
          
          <ul class="plan-features">
            {plan.features.map(feature => (
              <li class={feature.included ? '' : 'unavailable'}>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  {feature.included ? (
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  ) : (
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                  )}
                </svg>
                {feature.text}
              </li>
            ))}
          </ul>
          
          <a href="#" class={`plan-button ${plan.buttonType}`}>{plan.buttonText}</a>
        </article>
      ))}
    </div>

    <div class="cta-section">
      <h3>¿Necesitas algo personalizado?</h3>
      <p>Contáctanos para crear un plan a la medida de tu negocio.</p>
      <a href="#contacto" class="plan-button primary">Hablemos</a>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding: 80px 0;
  }

  .pricing-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 60px;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .pricing-header h2 {
    font-size: clamp(1.75rem, 6vw, 2.5rem);
    font-weight: 800;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }

  .pricing-header p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 60px;
  }

  .plan-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 32px 24px;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    animation: fadeInUp 0.6s ease forwards;
  }

  .plan-card:nth-child(1) { animation-delay: 0.1s; }
  .plan-card:nth-child(2) { animation-delay: 0.2s; }
  .plan-card:nth-child(3) { animation-delay: 0.3s; }

  .plan-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    opacity: 0;
    transition: opacity 0.3s;
  }

  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 229, 160, 0.1);
  }

  .plan-card:hover::before {
    opacity: 1;
  }

  .plan-card.featured {
    background: var(--color-surface-elevated);
    border-color: var(--color-primary);
  }

  .plan-card.featured::before {
    opacity: 1;
  }

  .badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .plan-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .plan-price {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 4px;
    letter-spacing: -2px;
  }

  .plan-price .currency {
    font-size: 1.5rem;
    vertical-align: top;
    margin-right: 4px;
  }

  .plan-price .period {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-muted);
    letter-spacing: 0;
  }

  .plan-description {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .plan-features {
    margin-bottom: 32px;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.9rem;
    padding: 8px 0;
    color: var(--color-text);
  }

  .plan-features li svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--color-primary);
  }

  .plan-features li.unavailable {
    color: var(--color-text-muted);
    text-decoration: line-through;
  }

  .plan-features li.unavailable svg {
    color: var(--color-text-muted);
  }

  .plan-button {
    display: block;
    width: 100%;
    padding: 16px 24px;
    border: none;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    text-decoration: none;
  }

  .plan-button.primary {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .plan-button.primary:hover {
    background: var(--color-primary-dim);
    transform: scale(1.02);
  }

  .plan-button.secondary {
    background: transparent;
    color: var(--color-text);
    border: 2px solid var(--color-border);
  }

  .plan-button.secondary:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .cta-section {
    text-align: center;
    padding: 40px 24px;
    background: var(--color-surface);
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
  }

  .cta-section h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 12px;
    letter-spacing: -1px;
  }

  .cta-section p {
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      align-items: start;
    }

    .plan-card.featured {
      transform: scale(1.05);
    }

    .plan-card.featured:hover {
      transform: scale(1.05) translateY(-4px);
    }
  }
</style>
